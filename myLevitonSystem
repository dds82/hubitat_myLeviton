def residenceOptions()
{
    def opts = [:]
    def residences = []
    try
    {
        residences = state?.residences ?: []
    }
    catch(Exception e)
    {
        return opts
    }

    for(res in residences)
    {
        def id = residenceField(res, "id")?.toString()
        if(!id)
        {
            continue
        }
        def name = residenceField(res, "name")?.toString()?.trim()
        opts[id] = name ?: "Residence ${id}"
    }
    return opts
}

def discoverResidences()
{
    def permissions = lev_residential_permissions()
    if(!permissions)
    {
        throw new Exception("No residential permissions returned")
    }

    def discovered = []
    for(perm in permissions)
    {
        def acctId = perm?.residentialAccountId
        if(acctId == null)
        {
            continue
        }

        setResAcctId(acctId)
        def residences = lev_residences() ?: []
        logDebug("account ${acctId} has ${residences.size()} residence(s)")
        for(res in residences)
        {
            discovered << [accountId: acctId, id: res.id, name: res?.name?.toString()?.trim()]
        }
    }

    if(!discovered)
    {
        throw new Exception("No residences returned")
    }

    state.residences = discovered
    log.info "My Leviton residences: ${discovered.collect { "${it.name} (${it.id})" }.join(', ')}"
    return discovered
}

def residenceField(res, String key)
{
    return (res instanceof Map) ? res[key] : res?."${key}"
}

def discoverSwitches()
{
    def selected = selectedResidenceId()
    if(!selected)
    {
        return []
    }

    if(!state.residences)
    {
        discoverResidences()
    }

    def match = null
    for(res in state.residences)
    {
        if(residenceField(res, "id")?.toString() == selected)
        {
            match = res
            break
        }
    }
    if(!match)
    {
        log.warn "Selected residence ${selected} is not on this My Leviton account"
        return []
    }

    setResAcctId(residenceField(match, "accountId"))
    setResidence(residenceField(match, "id"))
    def switches = lev_iot_switches() ?: []
    def name = residenceField(match, "name")?.toString()?.trim()
    log.info "Residence ${name} (${selected}) has ${switches.size()} switch(es)"
    return switches
}

