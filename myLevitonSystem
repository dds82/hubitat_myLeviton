def configure()
{
    state.clear()
    initialize()
}

def refreshTokens()
{
    unschedule(refreshTokens)
    
    try
    {
        // login id and userid
        def login = lev_login()
        setLogin(login)
        
        setAuth(login?.id)
        setUserId(login?.userId)
        setTtl(login?.ttl)
        
        // Load every residence so the preference dropdown can list them.
        // Switches are fetched later, and only for the selected residence.
        discoverResidences()
        
        sendEvent(name: "commStatus", value: "good")
    }
    catch (Exception e)
    {
        logDebug("refreshTokens() failed: ${e}")
        sendEvent(name: "commStatus", value: "error")
        throw(e)
    }
    
    // schedule next refresh, 1 hour before expiration
    int delay = getTtl().toInteger() - 3600
    logDebug("refresh in ${delay}")
    runIn(delay, refreshTokens)
}

def refreshSystemInfo()
{
    if (state.asyncQueue == null)
        state.asyncQueue = new ArrayList()
    
    try
    {
        // switches info
        setSwitches(discoverSwitches())
        
        def switchesInfo = getSwitches()
        if(!selectedResidenceId())
        {
            log.info "Select a residence in preferences, then save, to create child devices"
        }
        else if(switchesInfo != null)
        {
            sendEvent(name: "commStatus", value: "good")
            removeChildrenNotIn(switchesInfo)
            log.info "My Leviton found ${switchesInfo.size()} switch(es) for the selected residence"
            
            def child
            for(thisSwitch in switchesInfo)
            {
                if(thisSwitch?.deleted)
                {
                    logDebug("skipping deleted switch ${thisSwitch.id}")
                    continue
                }
                logDebug("thisSwitch = ${thisSwitch}")
                child = manageChildDevice(thisSwitch.name, thisSwitch.id)
                if(child)
                {
                    // update child device
                    logDebug("updating child: ${thisSwitch.name} with power: ${thisSwitch.power} and brightness: ${thisSwitch.brightness}")
                    child.updateAttributes(thisSwitch.id, thisSwitch, false, true)
                }
            }
        }
    }
    catch (Exception e)
    {
        logDebug("refreshSystemInfo() failed: ${e.message}")
        sendEvent(name: "commStatus", value: "error")
        throw(e)
    }
    finally {
        def queue = state.asyncQueue
        if (queue != null) {
            state.asyncQueue = null
            for (queuedMsg in queue) {
                parse(queuedMsg)
            }
        }
    }
}

def refreshFromChild()
{
    refreshSystemInfo()
}

def initialize()
{
    unschedule(initialize)
    unschedule(reconnectWebSocket)
    sendEvent(name: "commStatus", value: "unknown")
    try
    {
        closeEventSocket()
        
        refreshTokens()
        refreshSystemInfo() // Populate state.switches and throw if HTTP fails
        openEventSocket()
    }
    catch (Exception e)
    {
        logDebug("initialize() failed: ${e.message}")
        sendEvent(name: "commStatus", value: "error")
        updateLabel()
        
        reinitialize()
    }
}

def reconnectWebSocket()
{
    unschedule(reconnectWebSocket)
    try
    {
        // If we don't have a valid login token or switch list yet, do a full initialize()
        if (!getAuth() || !getLogin() || !getSwitches()) {
            initialize()
            return
        }
        
        logDebug("Reconnecting WebSocket using existing auth token...")
        closeEventSocket()
        
        // IMPORTANT: Run refreshSystemInfo() BEFORE openEventSocket()!
        // Running it after openEventSocket() causes an 8-second thread overlap that overwrites state.reconnectDelay!
        refreshSystemInfo()
        openEventSocket()
    }
    catch (Exception e)
    {
        logDebug("reconnectWebSocket() failed: ${e.message}")
        sendEvent(name: "commStatus", value: "error")
        updateLabel()
        
        reinitialize()
    }
}

def uninstalled()
{
    closeEventSocket()
    unschedule()
}

def refresh()
{
    unschedule(refresh)
    
    try
    {
        refreshSystemInfo()
    }
    catch (Exception e)
    {
        logDebug("refresh() failed")
    }
}

def openEventSocket()
{
    try
    {
        // Let OkHttp generate Sec-WebSocket-Key, Upgrade, and Connection headers automatically.
        // Explicitly set pingInterval (in seconds) to prevent idle NAT/load-balancer drops.
        interfaces.webSocket.connect(
            "wss://my.leviton.com/socket/websocket",
            origin: "https://my.leviton.com"
        )
        
        sendEvent(name: "commStatus", value: "good")
    }
    catch (Exception e)
    {
        logDebug("error: ${e.message}")
        sendEvent(name: "commStatus", value: "error")        
        throw(e)
    }
}

def closeEventSocket()
{
    setWasExpectedClose(true)
    interfaces.webSocket.close()
    // Give the old socket 1 second to finish closing before opening a new one
    pauseExecution(1000)
    // Reset to false so it never stays stuck as true if refreshTokens() fails or the hub reboots
    setWasExpectedClose(false)
}

def webSocketStatus(String message)
{
    try {
        logDebug("webSocketStatus: ${message}")
    
        if(message.startsWith("status: open"))
        {        
            sendEvent(name: "commStatus", value: "good")
        
            setReconnectDelay(1)
            setWasExpectedClose(false)
        
            return
        }
        else if(message.startsWith("status: closing"))
        {
            if(getWasExpectedClose())
            {
                setWasExpectedClose(false)
                return
            }
            
            sendEvent(name: "commStatus", value: "no events")
            reinitialize()
        
            return
        }
        else if(message.startsWith("failure:"))
        {
            // Only mark commStatus as error if we've already failed at least one reconnect attempt (delay > 2)
            if (getReconnectDelay() > 2) {
                sendEvent(name: "commStatus", value: "error")
            }
            reinitialize()
        
            return
        }
    }
    finally {
        updateLabel()
    }
}

def updateLabel() {
    def label = device.getName()
    if (includeStatusInLabel) {
        switch (device.currentValue("commStatus")) {
            case "good":
                label += " (${getUsername()}; Online)"
                break
           
            case "error":
                label += " (${getUsername()}; Offline)"
                break
        }
    }
        
    device.setLabel(label)
}

def reinitialize()
{
    unschedule(initialize)
    unschedule(reconnectWebSocket)
    
    int currentDelay = getReconnectDelay()
    int delayCalc = currentDelay * 2
    int reconnectDelay = delayCalc <= 600 ? delayCalc : 600
    
    setReconnectDelay(reconnectDelay)
    logDebug("Reconnecting in ${reconnectDelay} seconds...")
    runIn(reconnectDelay, reconnectWebSocket)
}

def setReconnectDelay(int delay)
{
    reconnectDelayMap[device.idAsLong] = delay
    state.reconnectDelay = delay
}

int getReconnectDelay()
{
    Integer val = reconnectDelayMap[device.idAsLong]
    return (val != null) ? val : (state.reconnectDelay ?: 1)
}

def parse(String message)
{
    logDebug("parse: ${message}")
    if (state.asyncQueue != null) {
        logDebug("Queueing message since a refresh is in progress")
        state.asyncQueue.add(message)
    }
    
    try
    {
        def msgJson = new groovy.json.JsonSlurper().parseText(message)
        
        if(msgJson?.type == "challenge")
        {
            interfaces.webSocket.sendMessage(new groovy.json.JsonOutput().toJson([token: getLogin()]))
        }
        
        if(msgJson?.type == "status" && msgJson?.status == "ready")
        {
            for(thisSwitch in getSwitches())
            {
                interfaces.webSocket.sendMessage(new groovy.json.JsonOutput().toJson([type: 'subscribe', subscription: [modelName: 'IotSwitch', modelId: thisSwitch.id]]))
            }
        }
        
        if(msgJson?.type == "notification")
        {
            def child = findChildDevice(msgJson.notification?.modelId)
            if(child)
            {
                child.updateAttributes(msgJson.notification.modelId, msgJson.notification.data)
            }
        }
    }

    catch (Exception e)
    {
        logDebug("parse() exception: ${e.message}")
    }
}  

