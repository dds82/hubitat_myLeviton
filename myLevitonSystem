def findChildDevice(id)
{
    return getChildDevice(childDni(id))
}

def createChildDevice(name, id)
{
    return addChildDevice("My Leviton Switch/Dimmer", childDni(id), [label:"${childName(name)}", isComponent:false, name:"${childName(name)}"])
}

void removeChildDevice(id) {
    String dni = childDni(id)
    log.info "Removing device ${dni}"
    deleteChildDevice(dni)
}

def removeChildrenNotIn(switchesInfo)
{
    def keep = []
    for(sw in switchesInfo)
    {
        if(sw?.deleted || sw?.id == null)
        {
            continue
        }
        keep << childDni(sw.id)
    }

    def remove = []
    def children = getChildDevices() ?: []
    for(child in children)
    {
        if(!keep.contains(child.deviceNetworkId))
        {
            remove << child.deviceNetworkId
        }
    }
    for(dni in remove)
    {
        log.info "Removing ${dni}; it is not in the selected residence"
        deleteChildDevice(dni)
    }
}

def manageChildDevice(name, id)
{
    logDebug("manageChildDevice(${name}, ${id})")
    
    def child = findChildDevice(id)
    if(child)
    {
        // use existing child if it exists...
        logDebug("found existing child: ${child}")
    }
    else
    {
        // create child if it didn't exist...
        child = createChildDevice(name, id)
        logDebug("created new child: ${child}")
    }
    
    return child
}

def childName(name)
{
    return "${name.toString()}"
}

def childDni(id)
{
    return "${device.getName()}-${id.toString()}"
}

def genParamsLogin()
{
    def params =
        [
            uri: getBaseURI() + "Person/login",
            headers:
            [
                'Connection': 'close'
            ],
            body:
            [
                'email': username,
                'password': password,
                'loggedInVia': 'myLeviton',
                'rememberMe': true
            ],
            contentType: 'application/json',
            timeout: 15
        ]
 
    return params
}

def genParamsMain(suffix, body = null)
{
    def params =
        [
            uri: getBaseURI() + suffix,
            headers:
            [
                'Authorization': getAuth(),
                'Connection': 'close'
            ],
            contentType: 'application/json',
            timeout: 15
        ]
    
    if(body)
    {
        params['body'] = body
    }
 
    return params
}

def httpGetExec(params, throwToCaller = false)
{
    logDebug("httpGetExec(${params})")
    
    try
    {
        def result
        httpGet(params)
        { resp ->
            // Hubitat parses a JSON empty array as null, so log that
            // explicitly. An empty list is a successful response.
            if (resp.data != null)
            {
                logDebug("resp.data = ${resp.data}")
                result = resp.data
            }
            else
            {
                logDebug("resp.data = null (status ${resp?.status})")
            }
        }
        return result
    }
    catch (Exception e)
    {
        logDebug("httpGetExec() failed: ${e.message}")
        if(throwToCaller)
        {
            throw(e)
        }
    }
}

def httpPostExec(params, throwToCaller = false)
{
    logDebug("httpPostExec(${params})")
    
    try
    {
        def result
        httpPost(params)
        { resp ->
            // Hubitat parses a JSON empty array as null, so log that
            // explicitly. An empty list is a successful response.
            if (resp.data != null)
            {
                logDebug("resp.data = ${resp.data}")
                result = resp.data
            }
            else
            {
                logDebug("resp.data = null (status ${resp?.status})")
            }
        }
        return result
    }
    catch (Exception e)
    {
        logDebug("httpPostExec() failed: ${e.message}")
        if(throwToCaller)
        {
            throw(e)
        }
    }
}

def httpExec(operation, params, throwToCaller = false)
{
    def res
    
    switch(operation)
    {
        default:
            logDebug("unsupported Http operation")
            break
        
        case "POST":
            res = httpPostExec(params, throwToCaller)
            break
        
        case "GET":
            res = httpGetExec(params, throwToCaller)
            break
    }
    
    return res
}

def httpExecWithAuthCheck(operation, params, throwToCaller = false)
{
    def res
    try
    {
        res = httpExec(operation, params, true)                
        return res
    }
    catch (Exception e)
    {
        // Safely check for 401 without throwing NullPointerException on non-HTTP exceptions (like JSON lexing errors)
        def status = e.metaClass.respondsTo(e, "getResponse") ? e.getResponse()?.getStatus()?.toInteger() : null
        if(status == 401)
        {
            // 401 Unauthorized
            try
            {
                logDebug("httpExecWithAuthCheck() auth failed.  retrying...")
                
                refreshTokens()                
                
                // update with new Auth token
                params['headers']['Authorization'] = getAuth()
                
                res = httpExec(operation, params, true)
                return res
            }
            catch (Exception e2)
            {
                logDebug("httpExecWithAuthCheck() failed: ${e2.message}")
                if(throwToCaller)
                {
                    throw(e2)
                }
            }
        }
        else
        {
            if(throwToCaller)
            {
                throw(e)
            }
        }
    }
}
